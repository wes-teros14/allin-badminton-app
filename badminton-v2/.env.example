# Supabase credentials — put in .env.development (dev) and .env.production (prod)
# Vite auto-loads the right file: `npm run dev` → .env.development, `npm run build` → .env.production
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required only for running the seed script (npm run seed)
# Get from: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Neon data (Phase 1 of the Neon migration). Leave both unset to keep data on Supabase.
# Data API URL: `neon data-api get` (url). Anonymous token: a long-lived JWT {role: anonymous, aud: authenticated}
# signed with the key in the Data API's JWKS. It is public, like the Supabase anon key.
# VITE_NEON_DATA_API_URL=https://<endpoint>.apirest.<cell>.aws.neon.tech/neondb/rest/v1
# VITE_NEON_ANON_JWT=<jwt>

# Neon live updates. Leave both unset to keep Supabase Broadcast.
# Realtime URL: `neon env pull -s realtime` (NEON_REALTIME_URL). Seal URL: `neon functions get seal`.
# VITE_NEON_REALTIME_URL=wss://<endpoint>.rt.<cell>.aws.neon.tech/
# VITE_NEON_SEAL_URL=https://<branch-id>-seal.compute.<cell>.aws.neon.tech/
